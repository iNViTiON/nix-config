    "-": ["~", "‐", "‑", "‒", "–", "—", "―", "⁓", "−", "⸺", "⸻", "∓", "₋", "⁻"],
    "/": ["÷", "√", "‽", "⸘"],
    "*": ["×", "⋅", "ˣ", "ₓ"],
    "=": ["≤", "≥", "≠", "≈", "≙", "⊕", "⊗", "±", "≅", "≡", "₊", "⁺", "₌", "⁼"],
    "\\": ["`", "~"]
  }
}
